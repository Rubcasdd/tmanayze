# Copy to .env for local use. On Vercel, add the same names under
# Project -> Settings -> Environment Variables. Never put real keys in this file.

# ---- AI keys -------------------------------------------------------------
# One or more NVIDIA NIM keys (https://build.nvidia.com). With several, each
# AI request uses the next key in rotation and fails over to another if one is
# throttled or rejected. Separate keys with commas, spaces or new lines.
NVIDIA_NIM_API_KEYS=
# A single key also works (and is added to the pool if both are set).
NVIDIA_NIM_API_KEY=

# ---- Limits on a public site ---------------------------------------------
# Free AI analyses per visitor (0 = unlimited). On Vercel the defaults are 5 per
# hour and 20 per day; locally they are off unless you set them. Visitors who
# paste their own key in Settings are not limited.
# AI_LIMIT_PER_HOUR=5
# AI_LIMIT_PER_DAY=20
# Optional cap on ALL visitors combined per day (protects your keys' quota).
# AI_LIMIT_GLOBAL_PER_DAY=200
# Per-visitor cap on API calls per minute (default 120 on Vercel).
# API_LIMIT_PER_MINUTE=120
# Skips the AI limits for you: enter it in the site's Settings.
# ADMIN_CODE=

# Shared counter store so limits are exact across Vercel instances. Add
# "Upstash for Redis" from the Vercel Marketplace and these are set for you
# (KV_REST_API_URL / KV_REST_API_TOKEN also work). Without it, limits are counted
# per serverless instance, which is only a best-effort brake.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- Other ---------------------------------------------------------------
# Require this code on every /api call (visitors enter it in Settings).
# ACCESS_CODE=
# Contact details appended to the User-Agent sent to ManiaExchange / trackmania.io.
# API_CONTACT=
# Free trackmania.io key for a higher rate limit.
# TMIO_API_KEY=
# Use a different NIM model, or a self-hosted NIM endpoint.
# NIM_MODEL=
# NIM_URL=
